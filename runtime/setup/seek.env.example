export SEEK_SIM_PYTHON=/path/to/sim/bin/python
export SEEK_POLICY_PYTHON=/path/to/policy/bin/python
export SEEK_SAM_PYTHON=/path/to/sam3/bin/python
export SEEK_SAM3_CHECKPOINT=/path/to/authorized/sam3.pt
export SEEK_DATA_ROOT=/path/to/existing/benchmark-data
export SEEK_RESULTS_ROOT=/path/to/new/seek-results
export SEEK_RESILIENT_TRANSPORT=1
export SEEK_API_TOKEN_ENV=SEEK_MODEL_KEY
export PYTHONDONTWRITEBYTECODE=1
unset SEEK_FREEZE_LEARNING SEEK_EPISODE_ADAPTATION
source "$(dirname -- "${BASH_SOURCE[0]}")/paths.sh"
