diff --git a/utils/physics_trace.py b/utils/physics_trace.py
new file mode 100644
index 0000000000000000000000000000000000000000..883c94ce84b4d9d15e24b6896b9aa73d37d8fcec
--- /dev/null
+++ b/utils/physics_trace.py
@@ -0,0 +1,104 @@
+import json
+import os
+from pathlib import Path
+
+
+def plain(value):
+    if hasattr(value, 'detach'):
+        return value.detach().cpu().tolist()
+    if hasattr(value, 'tolist'):
+        return value.tolist()
+    if isinstance(value, dict):
+        return {str(k): plain(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [plain(v) for v in value]
+    return value
+
+
+def configure_contact_trace(scene_cfg, name, robot_cfg):
+    if not os.environ.get('SEEK_PHYSICS_TRACE_PATH'):
+        return robot_cfg
+    from isaaclab.sensors import ContactSensorCfg
+    setattr(scene_cfg, name + '_trace_contact', ContactSensorCfg(
+        prim_path=robot_cfg.prim_path + '/.*', update_period=0.0,
+        history_length=0, debug_vis=False))
+    return robot_cfg.replace(spawn=robot_cfg.spawn.replace(activate_contact_sensors=True))
+
+
+class PhysicsTrace:
+    def __init__(self, path, env):
+        self.file = Path(path).open('x', buffering=1)
+        self.manager = env.robot_manager
+        self.active = False
+        self.sequence = 0
+        self.write(dict(event='schema', schema='physics-substeps-1',
+            units=dict(joint_pos='rad for revolute, m for prismatic', joint_vel='rad/s or m/s',
+                       normal_contact_force_w='N', normal_contact_impulse_w='N*s',
+                       body_incoming_joint_wrench_b='N,N*m; parent body frame', pose='m,wxyz'),
+            torque_semantics='computed/applied fields are implicit actuator PD estimates, not actual solver drive forces',
+            contact_semantics='net normal force per body; friction and contact pairs not recorded',
+            robots=[dict(arm=r.arm_name, joint_names=k.joint_names, body_names=k.body_names,
+                         arm_indices=r.arm_joint_indices, gripper_indices=r.gripper_joint_indices,
+                         ee_link=r.ee_link_name, gripper_scale=r.gripper_scale,
+                         joint_limits=k.data.joint_pos_limits)
+                    for r,k in zip(self.manager.robot_list,self.manager.robot_key)]))
+
+    def write(self, value):
+        self.file.write(json.dumps(plain(value), separators=(',', ':')) + '\n')
+
+    def begin(self, env, actions, indices):
+        self.sequence += 1
+        self.substep = 0
+        self.active = True
+        self.write(dict(event='dispatch', dispatch=self.sequence,
+                        action_steps={i:env.take_action_cnt[i] for i in indices},
+                        actions=actions, ik_checks=env._last_ik_execution_checks))
+
+    def sample(self, sim):
+        robots=[]
+        for key in self.manager.robot_key:
+            d=key.data
+            robots.append(dict(joint_pos=d.joint_pos, joint_vel=d.joint_vel,
+                joint_pos_target=d.joint_pos_target, joint_vel_target=d.joint_vel_target,
+                physics_drive_pos_target=key._joint_pos_target_sim,
+                physics_drive_vel_target=key._joint_vel_target_sim,
+                computed_torque_estimate=d.computed_torque, applied_torque_estimate=d.applied_torque,
+                body_pose_w=d.body_link_pose_w, body_com_vel_w=d.body_com_vel_w,
+                body_incoming_joint_wrench_b=d.body_incoming_joint_wrench_b))
+        contacts={}
+        for name,sensor in sim.scene.sensors.items():
+            if name.endswith('_trace_contact'):
+                forces=sensor.contact_physx_view.get_net_contact_forces(dt=sim.physics_dt)
+                contacts[name]=dict(body_names=sensor.body_names, normal_contact_force_w=forces,
+                                    normal_contact_impulse_w=forces*sim.physics_dt)
+        if not contacts:
+            raise RuntimeError('Enabled physics trace has no contact sensors')
+        return plain(dict(robots=robots,contacts=contacts))
+
+    def before(self, sim):
+        if self.active:
+            self.substep += 1
+            self.write(dict(event='physics_pre',dispatch=self.sequence,substep=self.substep,
+                            physics_counter=sim._sim_step_counter,dt=sim.physics_dt,state=self.sample(sim)))
+
+    def after(self, sim):
+        if self.active:
+            self.write(dict(event='physics_post',dispatch=self.sequence,substep=self.substep,
+                            physics_counter=sim._sim_step_counter,dt=sim.physics_dt,state=self.sample(sim)))
+
+    def finish(self):
+        self.write(dict(event='dispatch_end',dispatch=self.sequence,substeps=self.substep))
+        self.active=False
+
+
+def begin_trace(env, actions, indices):
+    path=os.environ.get('SEEK_PHYSICS_TRACE_PATH')
+    if not path:
+        return None
+    sim=env.sim.unwrapped
+    trace=getattr(sim,'_physics_trace',None)
+    if trace is None:
+        trace=PhysicsTrace(path,env)
+        sim._physics_trace=trace
+    trace.begin(env,actions,indices)
+    return trace
